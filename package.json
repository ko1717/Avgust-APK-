{
  "name": "sites-project",
  "version": "1.5.35",
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "test:unit": "node --test",
    "test:integration": "node tests/team.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "desktop:build": "node desktop/build.cjs && vite build --config desktop/vite.config.ts",
    "desktop:start": "electron desktop",
    "desktop:test": "npm run desktop:build && node tests/desktop-store.cjs",
    "desktop:smoke": "npm run desktop:build && powershell -NoProfile -ExecutionPolicy Bypass -File tools/desktop-smoke.ps1",
    "test:backup": "pwsh -NoProfile -File tests/backup-restore.ps1",
    "desktop:installer": "npm run desktop:build && powershell -NoProfile -ExecutionPolicy Bypass -File tools/windows-installer.ps1",
    "android:sync": "cap sync android",
    "android:toolchain": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/android-toolchain.ps1",
    "android:apk": "npm run desktop:build && cap sync android && powershell -NoProfile -ExecutionPolicy Bypass -File tools/android-build.ps1"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "docx": "^9.7.1",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "sql.js": "^1.13.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
