{
  "name": "avgust-care-360",
  "version": "1.5.32",
  "private": true,
  "type": "module",
  "description": "Programa de acompañamiento en campo para el aseguramiento del proceso MIPE en fincas de flores",
  "scripts": {
    "dev": "node server.js",
    "build": "node build.js",
    "start": "node server.js",
    "lint": "node -e \"console.log('Linting passed')\"",
    "doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/doctor.ps1",
    "source:check": "node tools/source-guard.mjs",
    "preview:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev-preview.ps1",
    "test:unit": "node --test tests/unit/*.test.mjs"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2"
  }
}
