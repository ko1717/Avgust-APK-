rules_version = '2';
// Deploy with: npm run deploy:firebase (targets the named DB in firebase.json).
// Portal clients may use Anonymous Auth; invitation-code lookup still needs
// unauthenticated list/get with a hard limit so the code flow keeps working
// even if Anonymous Auth is temporarily disabled.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'vixnine777@gmail.com' ||
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true)
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Bounded public list for portal invitation-code / farm filters (client always sends limit<=100).
    function portalListOk() {
      return request.query.limit != null && request.query.limit <= 100;
    }

    // New codes are ASEG-####. MIPE-#### stays valid so stored invitations can still be revoked.
    function isPortalInvitationCode(code) {
      return code is string && code.matches('^(ASEG|MIPE)-[0-9]{4}$');
    }

    function farmFieldOk() {
      return request.resource.data.farm is string &&
        request.resource.data.farm.size() > 0 &&
        request.resource.data.farm.size() <= 250;
    }

    // Invitaciones de acceso exclusivo para responsables de fincas.
    // Reads stay open (code lookup works without Anonymous Auth).
    // Technician create/update stays on the client SDK (no auth required).
    match /invitations/{invitationId} {
      allow get: if isValidId(invitationId);
      allow list: if isSignedIn() || portalListOk();
      allow create: if isValidId(invitationId) &&
        farmFieldOk() &&
        request.resource.data.status == 'active' &&
        isPortalInvitationCode(request.resource.data.code);
      allow update: if isValidId(invitationId) &&
        farmFieldOk() &&
        request.resource.data.status in ['active', 'revoked'] &&
        (
          isPortalInvitationCode(request.resource.data.code) ||
          request.resource.data.code == resource.data.code
        );
      allow delete: if isAdmin();
    }

    // Informes en línea. Client reads; technician publish is a client SDK write.
    match /reports/{reportId} {
      allow get: if isValidId(reportId);
      allow list: if isSignedIn() || portalListOk();
      allow create, update: if isValidId(reportId) &&
        farmFieldOk() &&
        request.resource.data.date is string &&
        request.resource.data.date.size() > 0 &&
        request.resource.data.date.size() <= 40;
      allow delete: if isAdmin();
    }

    // Visitas publicadas. Same client-SDK write path as reports (merge on stable id).
    match /visits/{visitId} {
      allow get: if isValidId(visitId);
      allow list: if isSignedIn() || portalListOk();
      allow create, update: if isValidId(visitId) &&
        farmFieldOk() &&
        request.resource.data.date is string &&
        request.resource.data.date.size() > 0 &&
        request.resource.data.date.size() <= 40;
      allow delete: if isAdmin();
    }

    // Perfiles de administradores de fincas y técnicos
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Directorio de fincas
    match /farms/{farmId} {
      allow get, list: if true;
      allow create, update: if isValidId(farmId) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 250;
      allow delete: if isAdmin();
    }

    // Solicitudes de aseguramiento creadas desde el portal de finca (clientes)
    match /assuranceRequests/{requestId} {
      allow get: if isValidId(requestId);
      allow list: if isSignedIn() || portalListOk();
      allow create: if isValidId(requestId) &&
        request.resource.data.farm is string &&
        request.resource.data.farm.size() > 0 &&
        request.resource.data.farm.size() <= 250 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.source == 'farm-portal' &&
        request.resource.data.clientName is string &&
        request.resource.data.clientName.size() > 0 &&
        request.resource.data.clientName.size() <= 200;
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Colección de validación de conectividad
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
